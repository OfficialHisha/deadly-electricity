<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>DeadlyElectricity</AssemblyName>
    <Description>What if electricity wasn't that simple?</Description>
    <Version>1.0.3</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <StationeersDir>E:\SteamLibrary\steamapps\common\Stationeers\</StationeersDir>
    <StationeersManagedDirectory>$(StationeersDir)rocketstation_Data\Managed\</StationeersManagedDirectory>
    <BepinexCoreDirectory>$(StationeersDir)Bepinex\core\</BepinexCoreDirectory>
    <SLPDirectory>$(StationeersDir)Bepinex\plugins\StationeersLaunchPad\</SLPDirectory>
    <NoStandardLibraries>true</NoStandardLibraries>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
  </PropertyGroup>

  <ItemGroup>
    <GameDll Include="$(StationeersManagedDirectory)\*.dll" />
    <GameDll Include="$(BepinexCoreDirectory)\*.dll" Exclude="$(BepinexCoreDirectory)\0Harmony20.dll" />
    <GameDll Include="$(SLPDirectory)\LaunchPadBooster.dll" />
    <GameDlls Include="@(GameDll)">
      <HintPath>%(Identity)</HintPath>
    </GameDlls>
    <Reference Include="@(GameDlls->'%(Filename)')" Private="False" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Transpilers\" />
  </ItemGroup>
</Project>
